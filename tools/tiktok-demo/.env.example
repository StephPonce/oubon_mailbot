# Oubon Shop Automation — TikTok Developer Demo Site
# ====================================================
# Copy this file to .env and fill in the values from your TikTok
# Developer Portal (developers.tiktok.com → Oubon Shop Automation →
# App details → Credentials). USE SANDBOX CREDENTIALS for the demo
# recording — switch the portal to the "Sandbox" tab and copy the
# sandbox client key + secret from there.
#
# DO NOT commit the .env file. Only this example template is
# committed.

# From: Developer Portal → App details → Credentials
TIKTOK_CLIENT_KEY=awfl4ben3ftbj54c
TIKTOK_CLIENT_SECRET=replace-with-sandbox-secret

# The redirect URI must match EXACTLY what you've registered in
# the Developer Portal under Login Kit → Redirect URI.
# For local demo, use localhost. Then ADD this URL to your
# Developer Portal's Redirect URI list (you can have up to 10).
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# Use sandbox endpoints for the review demo (required by reviewer).
# Sandbox mode is selected in the Developer Portal — endpoints
# themselves are the same, but the credentials route to sandbox.
TIKTOK_API_BASE=https://open.tiktokapis.com
TIKTOK_AUTH_BASE=https://www.tiktok.com

# Express session signing secret — any random string for local dev.
# `openssl rand -hex 32` is the easy way.
SESSION_SECRET=change-me-to-a-random-string

# Server port
PORT=3000
