# =============================================================================
# OSPRA OS — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# IMPORTANT — quoting rules:
#   This file is loaded by python-dotenv (forgiving) AND sourced by
#   scripts/run.sh via `source .env` (strict bash).
#   ANY value containing one of these characters MUST be quoted:
#     space  ( )  [ ]  &  |  ;  <  >  $  *  ?  `  '  "
#   Examples:
#     BRAND_NAME="Ospra OS"
#     DATABASE_URL='postgresql://u:p@h/db?sslmode=require&channel_binding=require'
#     LABEL_AUTO_REPLIED="Auto Replied"
#   Unquoted spaces will cause `run.sh` to fail with
#   `<value>: command not found` at the line of the offending var.
#
# Legend:
#   [REQUIRED]  App will not start without this.
#   [PROD]      Required in production; optional in dev.
#   [FEATURE]   Optional — unlocks a specific feature when set.
#   [DEFAULT]   Has a sensible default; override only if needed.
# =============================================================================


# =============================================================================
# CORE / RUNTIME
# =============================================================================
ENVIRONMENT=development            # [DEFAULT] development | staging | production
LOG_LEVEL=INFO                     # [DEFAULT] DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                 # [DEFAULT] console | json
BRAND_NAME="Ospra OS"              # [DEFAULT] Tenant-facing brand name (override per deployment)
SUPPORT_FROM_NAME="Ospra Support"  # [DEFAULT]
SUPPORT_FROM_EMAIL=support@ospra.io # [DEFAULT]
BASE_URL=http://localhost:8000     # [DEFAULT] Used for OAuth redirects, email links


# =============================================================================
# SECURITY (all [PROD] — autogenerated for dev, MUST rotate for prod)
# =============================================================================
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-with-secrets-token-hex-32
SECRET_KEY=generate-with-secrets-token-hex-32

# Fernet key for encrypting email OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_OAUTH_ENCRYPTION_KEY=generate-fernet-key


# =============================================================================
# DATABASE
# =============================================================================
# [REQUIRED in prod] PostgreSQL URL. Dev falls back to local SQLite.
# Render's free Postgres uses postgres:// — our settings auto-rewrites to postgresql://.
#
# IMPORTANT — DO NOT also set OUBONSHOP_database_url. It existed historically
# as a local-dev SQLite override but ad-hoc scripts (and only scripts/init_db.py)
# read it FIRST, while the running backend reads DATABASE_URL. If both are set
# to different DBs, scripts will silently operate on the SQLite scratch file
# while the live app uses Postgres. Use DATABASE_URL only.
DATABASE_URL=sqlite+aiosqlite:///./ospra_os.db


# =============================================================================
# AI PROVIDERS  [FEATURE — at least one required for AI features]
# =============================================================================
AI_PROVIDER=openai                  # openai | anthropic | gemini | groq | xai
OPENAI_API_KEY=                     # [FEATURE] sk-...
OPENAI_MODEL=gpt-4o-mini            # [DEFAULT]
ANTHROPIC_API_KEY=                  # [FEATURE] sk-ant-...
GROQ_API_KEY=                       # [FEATURE] Used for cheap email-reply model
GOOGLE_AI_API_KEY=                  # [FEATURE] Gemini
XAI_API_KEY=                        # [FEATURE] Grok
STABILITY_API_KEY=                  # [FEATURE] Image background removal


# =============================================================================
# OBSERVABILITY  [FEATURE]
# =============================================================================
SENTRY_DSN=                          # [FEATURE] Crash reporting
SENTRY_ENVIRONMENT=production        # [DEFAULT]
SENTRY_TRACES_SAMPLE_RATE=0.1        # [DEFAULT]
SENTRY_PROFILES_SAMPLE_RATE=0.1      # [DEFAULT]
SLACK_WEBHOOK_URL=                   # [FEATURE] Alerts for priority issues


# =============================================================================
# PAYMENTS  [FEATURE — required for subscription billing]
# =============================================================================
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=


# =============================================================================
# SHOPIFY  [FEATURE — required for store deployment]
# =============================================================================
SHOPIFY_PARTNER_CLIENT_ID=
SHOPIFY_PARTNER_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8001/api/shopify/oauth/callback
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2025-01          # [DEFAULT]
SHOPIFY_MODE=safe                    # [DEFAULT] safe | live
# Per-tenant dev store (optional, used by single-tenant mode only):
SHOPIFY_STORE=                       # e.g. my-store.myshopify.com
SHOPIFY_API_TOKEN=                   # Admin API access token


# =============================================================================
# ALIEXPRESS  [FEATURE — required for product discovery from AliExpress]
# =============================================================================
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_REDIRECT_URI=http://localhost:8001/api/aliexpress/oauth/callback
ALIEXPRESS_WEBHOOK_SECRET=


# =============================================================================
# CJ DROPSHIPPING  [FEATURE — required for CJ supplier discovery]
# =============================================================================
CJ_API_EMAIL=
CJ_API_KEY=
CJ_WEBHOOK_SECRET=


# =============================================================================
# AMAZON PA-API  [FEATURE — required for review-based sentiment signal]
# =============================================================================
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_COUNTRY=US                    # [DEFAULT]


# =============================================================================
# APIFY  [FEATURE — web scraping: reviews, trends, tiktok]
# =============================================================================
APIFY_API_TOKEN=


# =============================================================================
# EMAIL OAUTH  [FEATURE — required for email automation]
# =============================================================================
# Google (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT_ID=             # [FEATURE] For Pub/Sub push notifications
GMAIL_PUBSUB_TOPIC=gmail-notifications

# Microsoft (Outlook)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# iCloud — app-specific-password flow (no OAuth)
# (no env vars needed; credentials stored per-user in DB encrypted with EMAIL_OAUTH_ENCRYPTION_KEY)

# Transactional email (outbound)
RESEND_API_KEY=                      # [FEATURE] Used for password reset, notifications


# =============================================================================
# AD PLATFORMS  [FEATURE — required for ad automation]
# =============================================================================
# Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# TikTok (ads + content OAuth — NOT TikTok Shop yet; see TASKS.md)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_REDIRECT_URI=http://localhost:8001/api/tiktok/auth/callback
TIKTOK_WEBHOOK_SECRET=

# Google Ads
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=


# =============================================================================
# SEARCH / TRENDS  [FEATURE]
# =============================================================================
GOOGLE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_SECRET=


# =============================================================================
# QUIET HOURS (email automation)
# =============================================================================
QUIET_HOURS_START=21:00              # [DEFAULT] Local server time (24h format)
QUIET_HOURS_END=07:00                # [DEFAULT]
QUIET_HOURS_TIMEZONE=America/New_York # [DEFAULT] IANA tz name
AUTO_REPLY_ENABLED=true              # [DEFAULT]


# =============================================================================
# ENV VAR PREFIX NOTE
# =============================================================================
# Historically Settings used env_prefix="OUBONSHOP_". Both prefixed and
# unprefixed names are honored; prefer unprefixed going forward.
# (Documented here so nobody is surprised by `OUBONSHOP_OPENAI_API_KEY` in
# older deployments.)
