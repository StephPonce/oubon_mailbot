# =============================================================================
# OSPRA OS ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# --- Environment ---
ENVIRONMENT=development
# Options: development, staging, production

# --- AI Provider Selection ---
AI_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORG_ID=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Groq ---
GROQ_API_KEY=your-groq-api-key-here

# --- Google Gemini ---
GOOGLE_AI_API_KEY=your-google-api-key-here

# --- xAI Grok ---
XAI_API_KEY=your-xai-api-key-here

# --- Stability AI ---
STABILITY_API_KEY=your-stability-api-key-here

# =============================================================================
# SHOPIFY
# =============================================================================
SHOPIFY_PARTNER_CLIENT_ID=your-client-id
SHOPIFY_PARTNER_CLIENT_SECRET=your-client-secret
SHOPIFY_REDIRECT_URI=http://localhost:8001/api/shopify/oauth/callback
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# ALIEXPRESS
# =============================================================================
ALIEXPRESS_APP_KEY=your-app-key
ALIEXPRESS_APP_SECRET=your-app-secret
ALIEXPRESS_REDIRECT_URI=http://localhost:8001/api/aliexpress/oauth/callback

# =============================================================================
# EMAIL & OAUTH
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
EMAIL_OAUTH_ENCRYPTION_KEY=your-fernet-key-here
RESEND_API_KEY=your-resend-api-key

# =============================================================================
# PAYMENTS
# =============================================================================
LEMONSQUEEZY_API_KEY=your-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./ospra_os.db

# =============================================================================
# SECURITY (REQUIRED IN PRODUCTION)
# =============================================================================
JWT_SECRET_KEY=generate-with-secrets-token-hex-32
SECRET_KEY=generate-with-secrets-token-hex-32
