APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Gmail OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth2callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify
GOOGLE_TOKEN_FILE=.secrets/gmail_token.json
GOOGLE_CREDENTIALS_FILE=.secrets/credentials.json

# AI Providers for intelligent replies (during operating hours)
# Priority: Claude > OpenAI > Template fallback
CLAUDE_API_KEY=                                    # Anthropic Claude API key (recommended)
OPENAI_API_KEY=                                    # OpenAI API key (fallback)

# Shopify for order lookup, tracking, and refunds
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_API_TOKEN=your_admin_api_token
SHOPIFY_MODE=safe

# Shopify OAuth 2.0 (for multi-store connections)
OUBONSHOP_SHOPIFY_API_KEY=                                  # Shopify App API Key
OUBONSHOP_SHOPIFY_API_SECRET=                               # Shopify App API Secret
OUBONSHOP_SHOPIFY_REDIRECT_URI=http://localhost:8000/oauth/shopify/callback

# Amazon Product Advertising API (PA-API 5.0)
# Get these from: https://affiliate-program.amazon.com/assoc_credentials/home
OUBONSHOP_AMAZON_ACCESS_KEY=                           # PA-API Access Key
OUBONSHOP_AMAZON_SECRET_KEY=                           # PA-API Secret Key
OUBONSHOP_AMAZON_PARTNER_TAG=                          # Amazon Associate Tracking ID
OUBONSHOP_AMAZON_COUNTRY=US                            # Marketplace: US, UK, DE, FR, JP, etc.

# Apify (Web Scraping Infrastructure for TikTok Shop & Product Trends)
# Get token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=                                        # Apify API token for running actors

# Meta (Facebook/Instagram) Ads Platform
# Get these from: https://business.facebook.com/settings/ad-accounts
OUBONSHOP_META_APP_ID=                                  # Meta App ID
OUBONSHOP_META_APP_SECRET=                              # Meta App Secret
OUBONSHOP_META_ACCESS_TOKEN=                            # Meta Access Token
OUBONSHOP_META_AD_ACCOUNT_ID=                           # Meta Ad Account ID (without 'act_' prefix)
OUBONSHOP_META_PAGE_ID=                                 # Facebook Page ID

# TikTok Ads Platform
# Get these from: https://ads.tiktok.com/marketing_api/apps
OUBONSHOP_TIKTOK_APP_ID=                                # TikTok App ID
OUBONSHOP_TIKTOK_SECRET=                                # TikTok App Secret
OUBONSHOP_TIKTOK_ACCESS_TOKEN=                          # TikTok Access Token
OUBONSHOP_TIKTOK_ADVERTISER_ID=                         # TikTok Advertiser ID

# Google Ads Platform
# Get these from: https://ads.google.com/aw/apicenter
# Requires: google-ads SDK (uv add google-ads==23.1.0)
# Also create google-ads.yaml in project root
OUBONSHOP_GOOGLE_ADS_CUSTOMER_ID=                       # Google Ads Customer ID
OUBONSHOP_GOOGLE_ADS_DEVELOPER_TOKEN=                   # Developer Token (requires approval)
OUBONSHOP_GOOGLE_ADS_CLIENT_ID=                         # OAuth Client ID
OUBONSHOP_GOOGLE_ADS_CLIENT_SECRET=                     # OAuth Client Secret
OUBONSHOP_GOOGLE_ADS_REFRESH_TOKEN=                     # OAuth Refresh Token

# Optional: Slack notifications
SLACK_WEBHOOK_URL=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/mailbot.db

# Google Cloud Pub/Sub (for Gmail push notifications)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GMAIL_PUBSUB_TOPIC=gmail-notifications
