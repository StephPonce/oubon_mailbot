# API Configuration
VITE_API_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001

# Production
# VITE_API_URL=https://api.ospra.io
# VITE_WS_URL=wss://api.ospra.io

# Environment
VITE_ENV=development

# PostHog product analytics (frontend) — optional. Leave unset and the
# app no-ops the analytics layer cleanly. The PUBLIC project API key is
# safe to ship in the browser bundle. Server-side analytics use a
# separate PostHog key set via POSTHOG_API_KEY in the backend env.
# VITE_POSTHOG_KEY=phc_your_public_project_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com
